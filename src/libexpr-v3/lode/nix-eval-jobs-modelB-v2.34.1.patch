+     * flake job through v3.
+     */
+    static Drv fromV3(std::string &attrPath, nix::EvalState &state,
+                      nix::v3::EvalJobsHandle &v3h, MyArgs &args,
+                      Constituents constituents = {});
+
     std::string name;
     std::string storeDir;
     std::string system;
